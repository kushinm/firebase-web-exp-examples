{
  "hosting": {
    "public": "experiments/01-balanced-conditions",
    "ignore": [
      "**/.*",
      "**/README.md",
      "**/*.test.mjs",
      "**/firebase-config.example.js",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "experiments/01-balanced-conditions/firestore.rules"
  }
}
